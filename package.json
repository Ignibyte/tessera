{
  "name": "tessera",
  "version": "0.3.1",
  "private": true,
  "description": "Browser runtime for server-rendered sites: server HTML morphed in by region and component, over responses and SSE.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "sums": "node scripts/sums.ts",
    "size": "node scripts/size.ts",
    "test:browser": "playwright test",
    "test:browser:webkit": "node scripts/webkit.ts",
    "check": "node scripts/check.ts",
    "serve:test": "node test/server/main.ts"
  },
  "dependencies": {
    "idiomorph": "0.7.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
